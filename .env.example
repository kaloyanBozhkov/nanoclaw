TELEGRAM_BOT_TOKEN=
# Model the container agent runs on (defaults to the latest Claude Fable).
ANTHROPIC_MODEL=claude-fable-5

# Owner sender IDs (Telegram numeric user IDs, comma-separated) for owner-only commands (/model, /switch)
OWNER_IDS=

# --- Anthropic identities -----------------------------------------------
# A chat authenticates and bills as one identity, shown by /org and changed
# with /switch <name>. Credentials stay here: only the routing key
# "nanoclaw:<name>" is ever passed to a container, so no token reaches the
# container environment, the database, or a log.
#
# The credential below registers as the identity named "default" — a
# single-account install needs nothing else.
CLAUDE_CODE_OAUTH_TOKEN=
#
# Extra identities. The suffix declares how the credential authenticates:
#   _OAUTH_TOKEN → claude.ai OAuth (required to read Claude Design files)
#   _API_KEY     → console API key (cannot read Claude Design files)
# ANTHROPIC_ORG_WORK_OAUTH_TOKEN=
# ANTHROPIC_ORG_SIDE_API_KEY=
#
# Which identity a chat uses before it has ever switched. Defaults to "default".
# ANTHROPIC_DEFAULT_ORG=default
